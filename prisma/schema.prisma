generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  name      String
  username  String   @unique
  password  String
  createdAt DateTime @default(now())
  cases     Case[]
}

model Case {
  id            String     @id @default(cuid())
  title         String
  patientAge    Int?
  patientGender String?
  symptoms      String?
  clinicalNotes String?
  status        CaseStatus @default(OPEN)
  createdById   String
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  analyses      Analysis[]
  createdBy     User       @relation(fields: [createdById], references: [id])
  documents     Document[]
}

model Document {
  id            String       @id @default(cuid())
  caseId        String
  type          DocumentType
  fileUrl       String
  fileName      String
  mimeType      String
  extractedText String?
  createdAt     DateTime     @default(now())
  case          Case         @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

model Analysis {
  id              String   @id @default(cuid())
  caseId          String
  createdAt       DateTime @default(now())
  aiModel         String
  differentialDx  Json
  recommendations Json
  redFlags        String[]
  summary         String
  case            Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)
}

enum CaseStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

enum DocumentType {
  LAB_REPORT
  XRAY
  CT
  MRI
  NOTES
  OTHER
}
